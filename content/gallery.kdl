// The Gallery tab (.scratch/gallery/): sections of examples to run or load
// into the editor, in this order. Each entry points at an example where it
// already lives, so nothing is copied:
//   help "<command key>" "<example title>"   a help example in content/reference.kdl
//   lesson <n> "<name>" title="..."          a lesson's program, named after its
//                                            fence's language: ```logo <name>
//   file "<path>" title="..."                a .logo file, built into the app
// A test checks that every entry still points at a real example.

section "Made for the gallery" {
  file "examples/gallery/snowflake.logo" title="A snowflake"
  file "examples/gallery/spirograph.logo" title="A spirograph"
  file "examples/gallery/blossom.logo" title="A tree in blossom"
  file "examples/gallery/city.logo" title="A city at night"
  file "examples/gallery/garden.logo" title="A garden at night"
}

section "Halloween" {
  file "examples/gallery/spiderweb.logo" title="A spider's web"
  file "examples/gallery/ghost.logo" title="A friendly ghost"
  file "examples/gallery/lightning.logo" title="A storm"
  file "examples/gallery/pumpkin.logo" title="A jack-o'-lantern"
  file "examples/gallery/cauldron.logo" title="A witch's cauldron"
}

