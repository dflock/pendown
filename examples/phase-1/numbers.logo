; The language: procedures, variables, control, numbers, words and lists.

TO SPIRAL :size
  IF :size > 300 [STOP]
  FD :size RT 91
  SPIRAL :size + 4
END

TO DOUBLE :n
  OUTPUT PRODUCT :n 2
END

TO GROW :n
  LOCAL "big
  LOCALMAKE "small :n
  MAKE "big DOUBLE :small
  OUTPUT THING "big
END

TO COUNTDOWN
  MAKE "count 3
  FOREVER [
    IF :count = 0 [STOP]
    PRINT :count
    MAKE "count :count - 1
  ]
END

SETPC "skyblue
SPIRAL 4
PRINT GROW 21
COUNTDOWN
PRINT "liftoff
REPEAT 3 [TYPE REPCOUNT] PRINT "
IFELSE 2 > 1 [PRINT "yes] [PRINT "no]
PRINT (SUM 1 2 3) PRINT DIFFERENCE 10 4 PRINT MINUS 5
PRINT QUOTIENT 7 2 PRINT REMAINDER -7 3 PRINT MODULO -7 3
PRINT INT 3.7 PRINT ROUND 3.5 PRINT SQRT 16 PRINT POWER 2 10
PRINT SIN 30 PRINT COS 60 PRINT ARCTAN 1
PRINT (RANDOM 5 5)
PRINT LESSP 1 2 PRINT GREATERP 1 2 PRINT LESSEQUALP 2 2 PRINT GREATEREQUALP 1 2
PRINT EQUALP 0.1 + 0.2 0.3 PRINT NOTEQUALP 1 2
PRINT AND "true "false PRINT OR "true "false PRINT NOT "false
SHOW LIST 1 2 SHOW SE [a b] "c SHOW WORD "pen "down
PRINT FIRST [a b c] PRINT LAST "logo SHOW BF [a b c] SHOW BL [a b c]
PRINT ITEM 2 [x y z] PRINT COUNT [a b c] PRINT EMPTYP []
