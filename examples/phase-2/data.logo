; Words, lists and arrays: counting letters, with a bar chart of the counts.

MAKE "sentence [The Quick brown fox Jumps over the lazy dog]
PRINT FIRSTS :sentence
SHOW BFS [[a b] [c d]]
SHOW REMDUP [a b a c b]
SHOW REMOVE "the [the cat and the hat]
PRINT UPPERCASE "shout
PRINT LOWERCASE "WHISPER
PRINT QUOTED "word
SHOW MEMBER "fox :sentence
PRINT MEMBERP "fox :sentence
PRINT SUBSTRINGP "own "brown
PRINT BEFOREP "apple "banana
PRINT (LIST WORDP "a LISTP [a] NUMBERP 42 ARRAYP {1 2})
SHOW FPUT "start LPUT "end [middle]
SHOW COMBINE "a "bc
SHOW REVERSE [1 2 3]
PRINT CHAR (ASCII "a) + 1
PRINT PICK [heads tails]

; A stack and a queue.
MAKE "stack []
PUSH "stack 1
PUSH "stack 2
PRINT POP "stack
MAKE "line []
QUEUE "line "first
QUEUE "line "second
PRINT DEQUEUE "line

; Letter counts, in an array numbered from 0 for a to 25 for z.
MAKE "counts (ARRAY 26 0)
FOR [i 0 25] [SETITEM :i :counts 0]
TO TALLY :word
  FOREACH LOWERCASE :word [
    MAKE "n (ASCII ?) - (ASCII "a)
    SETITEM :n :counts (ITEM :n :counts) + 1
  ]
END
FOREACH :sentence [TALLY ?]
SHOW ARRAYTOLIST :counts

; A bar for each letter.
SETPC "orange
SETPENSIZE 12
FOR [i 0 25] [
  PU SETXY -480 + :i * 37 -300 PD
  SETY -290 + 60 * ITEM :i :counts
]

; A 3 by 3 grid of squares, coloured from a two-dimensional array.
MAKE "grid MDARRAY [3 3]
FOR [i 1 3] [FOR [j 1 3] [MDSETITEM (LIST :i :j) :grid "gray]]
MDSETITEM [2 2] :grid "red
SHOW MDITEM [2 2] :grid
SHOW LISTTOARRAY [x y z]
SETPENSIZE 1
SETPC "white
FOR [i 1 3] [FOR [j 1 3] [
  PU SETXY 160 + :i * 70 160 + :j * 70 PD
  SETFC MDITEM (LIST :i :j) :grid
  SQUARE 60
]]
