}

section "Colour" {
  help "setpencolor" "Rainbow"
  lesson 7 program 3 title="Rainbow hexagons"
  help "setpencolor" "Every palette colour"
  help "pick" "A random colour each time"
  help "ifelse" "Two colours"
  lesson 7 program 5 title="A target"
  help "circle" "Filled circles"
  help "setfillcolor" "See-through"
}

section "Shapes inside shapes" {
  help "to" "A procedure that calls itself"
  lesson 6 program 2 title="Squares at the corners"
  lesson 6 program 3 title="A tree"
  lesson 4 program 2 title="A house"
}

section "Circles, waves and chance" {
